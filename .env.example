# Copy to .env and fill in real values (e.g. copy .env.example .env on Windows).

# Server
PORT=8080
NODE_ENV=development

# MongoDB Atlas (base URI only; app appends DB name — see src/constants.js getDbName())
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>
# Local only (NODE_ENV=development): database name appended to MONGODB_URI. Production uses myapihubDB.
LOCAL_API_HUB_DB=my_local_db_name

# CORS: "*" or comma-separated origins (used with credentials: true)
CORS_ORIGIN=http://localhost:5173,https://me-habito.vercel.app

# JWT — use long random strings; in production secrets must differ and be at least 32 characters each
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal cron auth (optional but recommended for protected cron endpoints)
CRON_SECRET=replace-with-long-random-string

# Cookie behavior (httpOnly auth cookies — see src/utils/authCookies.util.js)
# Unique cookie names reduce clashes if multiple apps share a parent domain or proxy.
AUTH_ACCESS_TOKEN_COOKIE_NAME=myapihub_access_token
AUTH_REFRESH_TOKEN_COOKIE_NAME=myapihub_refresh_token
#
# Local dev (HTTP, e.g. Vite on localhost): omit COOKIE_* or leave unset — app uses sameSite=lax
# and secure=false unless you set SameSite=none (not recommended on http://).
#
# Production (HTTPS API + SPA on another origin, e.g. Cloud Run API + Vercel frontend):
# SameSite=None + Secure is required for cross-site cookies. Set these on the API only.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
