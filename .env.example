# Copy to .env and fill in real values (e.g. copy .env.example .env on Windows).

# Server
PORT=8080
NODE_ENV=development

# MongoDB (base URI only; app appends DB name from src/constants.js)
MONGODB_URI=mongodb://127.0.0.1:27017

# CORS: "*" or comma-separated origins (used with credentials: true)
CORS_ORIGIN=http://localhost:5173

# Cron (Vercel Cron hits GET /api/v1/internal/cron/habits/mark-missed with Authorization: Bearer <CRON_SECRET>)
# Set the same value in the Vercel project environment as CRON_SECRET.
CRON_SECRET=change-me-to-a-long-random-cron-secret-min-32-chars

# JWT — use long random strings; in production secrets must differ and be at least 32 characters each
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh-secret-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies (httpOnly). For cross-site frontends use COOKIE_SAME_SITE=none and COOKIE_SECURE=true (HTTPS only).
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
