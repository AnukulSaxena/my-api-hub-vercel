# Copy to .env and fill in real values (e.g. copy .env.example .env on Windows).

# Server
PORT=8080
NODE_ENV=development

# MongoDB Atlas (base URI only; app appends DB name from src/constants.js)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>

# CORS: "*" or comma-separated origins (used with credentials: true)
CORS_ORIGIN=http://localhost:5173

# JWT — use long random strings; in production secrets must differ and be at least 32 characters each
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal cron auth (optional but recommended for protected cron endpoints)
CRON_SECRET=replace-with-long-random-string

# Cookie behavior (optional overrides)
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
